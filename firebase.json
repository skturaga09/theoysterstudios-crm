{
  "functions": [
    {
      "source": "apps/api/deploy",
      "codebase": "api",
      "runtime": "nodejs22",
      "predeploy": [
        "pnpm --filter @pinnacle/api bundle"
      ]
    }
  ],
  "hosting": {
    "public": "apps/web/dist",
    "ignore": [
      "**/.*"
    ],
    "predeploy": [
      "pnpm --filter @pinnacle/web build"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-south1"
        }
      },
      {
        "source": "/assets/**",
        "destination": "/missing-asset"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}

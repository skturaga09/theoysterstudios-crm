# Copy to apps/api/.env and fill in. Never commit the real file.
# Firebase console → Firestore → your Enterprise database → Connect (MongoDB). Keep retryWrites=false.
MONGODB_URI=mongodb://USERNAME:PASSWORD@UID.asia-south1.firestore.goog:443/DATABASE_ID?loadBalanced=true&authMechanism=SCRAM-SHA-256&tls=true&retryWrites=false
# Firebase project used for Google sign-in, and the CRM admins' Google addresses (comma-separated).
FIREBASE_PROJECT_ID=theoysterstudios-crm-staging
ADMIN_EMAIL=owner@gmail.com,owner@yourstudio.com
# Optional: developer support login(s) — admin access, never stored in or shown by the CRM.
SUPPORT_EMAILS=
PORT=8787
